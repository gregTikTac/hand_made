# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
DATABASE_URL=postgres://shop_user:shop_password@db:5432/shop_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (dev uses Mailpit)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=dev@example.com

# Storage: local for dev (empty or 'local'); 's3' for production
STORAGE_BACKEND=local

# S3 (used only when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ru-central1
AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_S3_CUSTOM_DOMAIN=
AWS_PRIVATE_BUCKET_NAME=
AWS_PRIVATE_ENDPOINT_URL=https://storage.yandexcloud.net
PRIVATE_URL_EXPIRE_SECONDS=300

# Payment provider (mock in dev)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_SHOP_ID=

# Misc
SITE_NAME=Петелька
ADMIN_URL=admin/

# Contact links (empty = hidden). Instagram: see docs/client-questions.md #5
SUPPORT_URL=
VK_URL=
TELEGRAM_URL=
INSTAGRAM_URL=

# Superuser for `make superuser-env` (dev only; set real values in production .env)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
